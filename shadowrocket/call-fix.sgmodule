#!name=Incoming Call Fix (VoWiFi / APNs / VoIP)
#!desc=修复开启 Shadowrocket 后部分来电打不进来、且无通话记录的问题。放行运营商 IMS/VoWiFi、APNs 推送与 FaceTime 媒体流。
#!author=StevenG3
#!homepage=https://github.com/StevenG3/proxy-rules

# ─────────────────────────────────────────────────────────────────────────
# 单独导入本模块即可，与 personal-rules.module 并用时请把本模块排在更前面
# （配置 > 模块 > 右上角 ··· > 重新排序）。
#
# 注意：本模块只能修正"流量进入隧道后走错策略"。以下两项在规则匹配之前
# 就生效，模块无法覆盖，必须手动设置（详见 README）：
#
#   1. 设置 > 隧道 > 包括所有网络 > 「包括APNs」「包括蜂窝服务」→ 关
#   2. 设置 > 代理 > 代理类型 > 选「HTTP」而非「None」
#
# 关于第 2 点：手册对两种类型的定义是
#   HTTP —— 系统代理模式，对于不支持的程序会交给 TUN 接管网络连接
#   None —— TUN 模式，全部网络请求都将通过 TUN 接口进行处理
# 即 HTTP 模式本身已带 TUN 兜底。Telegram 的 MTProto 属于"不支持系统代理
# 的程序"，在 HTTP 模式下同样由 TUN 接管、照常走代理，推送不受影响；
# 而 None 会把本该绕开的系统服务也一并吃进隧道。
# ─────────────────────────────────────────────────────────────────────────

[General]
# 当 UDP 流量匹配到不支持 UDP 转发的节点时，回退为直连而不是拒绝。
# 默认值 REJECT 会直接掐掉 VoIP 的媒体流，导致来电无声或干脆不响铃。
# 代价：命中代理策略的 UDP（如 QUIC）会以本机真实 IP 直连，介意者可删掉本行。
udp-policy-not-supported-behaviour = DIRECT

# ── TUN 旁路路由（仅港澳台 / 境外卡需要，大陆卡不必启用）──────────────
# Shadowrocket 的 TUN 接口只处理 TCP，VoWiFi 依赖的 ESP（IP 协议号 50）
# 无法被转发，需要让 ePDG 的地址段完全绕开隧道。
#
# 前提：经实测，中国移动 / 联通 / 电信 / 广电均未在公共 3GPP DNS 中发布
# ePDG 地址，即大陆运营商不提供 Wi-Fi 通话。用大陆卡时本项无意义，别开。
# 自查：python3 tools/lookup-epdg.py
#
# ⚠️ 模块中的 [General] 会「覆盖」配置文件中的同名项，不是追加。因此下方
#    已连同 Shadowrocket 的默认私有网段一并列出，启用时请勿删减。
#
# 末尾的 ePDG 段实测于 2026-08-09（港 / 台 / 日 au / AT&T），来源为公共
# 3GPP DNS 解析结果而非运营商官方文档，可能变更，请用上述脚本复核。
#
# tun-excluded-routes = 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 255.255.255.255/32, 239.255.255.250/32, 120.88.224.0/24, 120.88.240.0/24, 180.219.134.0/24, 182.239.86.0/24, 182.239.118.0/24, 221.120.20.0/24, 221.120.23.0/24, 175.96.62.0/24, 175.96.63.0/24, 27.86.78.0/24, 107.122.31.0/24

[Host]
# ePDG / IMS 域名通常只有运营商下发的 DNS 能解析，公共 DoH 会解析失败。
# 若确认是 VoWiFi 注册不上，可启用下行改用系统 DNS 解析。
# 该写法未见于官方文档，属兼容性尝试，启用后若 DNS 异常请立即注释掉。
#
# *.pub.3gppnetwork.org = server:system

[Rule]
# 必须置顶：规则自上而下匹配，先匹配者胜出。
RULE-SET,https://raw.githubusercontent.com/StevenG3/proxy-rules/main/shadowrocket/call-direct.list,DIRECT
